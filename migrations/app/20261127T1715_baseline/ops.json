[
  {
    "id": "collection.categories.create",
    "label": "Create collection categories",
    "operationClass": "additive",
    "precheck": [
      {
        "description": "collection categories does not exist",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "categories"
        },
        "expect": "notExists",
        "object": "collection \"categories\""
      }
    ],
    "execute": [
      {
        "description": "create collection categories",
        "command": {
          "kind": "createCollection",
          "collection": "categories",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "color": {
                  "bsonType": "string"
                },
                "createdAt": {
                  "bsonType": "date"
                },
                "name": {
                  "bsonType": "string"
                },
                "type": {
                  "bsonType": "string",
                  "enum": [
                    "expense",
                    "income"
                  ]
                },
                "updatedAt": {
                  "bsonType": "date"
                }
              },
              "required": [
                "_id",
                "color",
                "createdAt",
                "name",
                "type",
                "updatedAt"
              ]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": []
  },
