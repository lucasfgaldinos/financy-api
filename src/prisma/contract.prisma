// use prisma-8

enum TransactionType {
  expense
  income
}

model User {
  id    ObjectId @id @map("_id")
  name  String
  email String   @unique
  @@map("users")
}

model Category {
  id             ObjectId @id @map("_id")
  name           String
  color          String
  type           TransactionType
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt
  transactions   Transaction[]

  @@unique([name, type])

  @@map("categories")
}

model Transaction {
  id             ObjectId @id @map("_id")
  description    String
  amount         Float
  date           DateTime
  type           TransactionType
  userId         String
  createdAt      temporal.CreatedAt
  updatedAt      temporal.UpdatedAt

  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

  @@map("transactions")

  @@index([userId, date])
  @@index([userId, date, categoryId])
}
